{
  "name": "YuriBanks",
  "version": "1.0.0",
  "description": "Aplica\u00e7\u00e3o de console (TypeScript) no estilo Conta Banc\u00e1ria com menu e opera\u00e7\u00f5es banc\u00e1rias.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
